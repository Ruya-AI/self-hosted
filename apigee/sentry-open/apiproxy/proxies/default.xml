<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description>Sentry ingestion proxy — forwards /open/sentry/* preserving path</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step><Name>SpikeArrest</Name></Step>
        </Request>
        <Response>
            <Step><Name>AddCorsHeaders</Name></Step>
        </Response>
    </PreFlow>
    <Flows>
        <Flow name="CORS Preflight">
            <Description>Handle OPTIONS preflight for browser SDKs</Description>
            <Condition>request.verb == "OPTIONS"</Condition>
            <Request/>
            <Response>
                <Step><Name>AddCorsHeaders</Name></Step>
            </Response>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <FaultRules>
        <FaultRule name="RateLimit">
            <Condition>(fault.name Matches "SpikeArrestViolation")</Condition>
            <Step><Name>AddSecurityHeaders</Name></Step>
        </FaultRule>
    </FaultRules>
    <HTTPProxyConnection>
        <BasePath>/open/sentry</BasePath>
        <VirtualHost>default</VirtualHost>
        <VirtualHost>secure</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="NoRoute">
        <Condition>request.verb == "OPTIONS"</Condition>
    </RouteRule>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
