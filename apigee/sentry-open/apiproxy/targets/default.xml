<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
    <Description>Sentry self-hosted on darkchain-services-sentry VM (internal VPC)</Description>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <Flows/>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step><Name>AddSecurityHeaders</Name></Step>
        </Response>
    </PostFlow>
    <HTTPTargetConnection>
        <URL>http://10.128.0.4:9000</URL>
        <Properties>
            <Property name="connect.timeout.millis">10000</Property>
            <Property name="io.timeout.millis">30000</Property>
        </Properties>
    </HTTPTargetConnection>
</TargetEndpoint>
