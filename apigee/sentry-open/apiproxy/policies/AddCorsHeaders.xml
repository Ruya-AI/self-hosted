<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="AddCorsHeaders">
    <DisplayName>Add CORS Headers</DisplayName>
    <Description>Required for browser-based Sentry SDKs</Description>
    <AssignTo createNew="false" type="response"/>
    <Set>
        <Headers>
            <Header name="Access-Control-Allow-Origin">*</Header>
            <Header name="Access-Control-Allow-Methods">GET, POST, PUT, OPTIONS</Header>
            <Header name="Access-Control-Allow-Headers">Content-Type, Accept, X-Sentry-Auth, sentry-trace, baggage</Header>
            <Header name="Access-Control-Expose-Headers">sentry-trace, baggage</Header>
            <Header name="Access-Control-Max-Age">86400</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
